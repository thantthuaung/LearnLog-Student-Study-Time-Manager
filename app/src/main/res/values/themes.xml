<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- ═════════════ App theme (light + dark via values-night colors) ═════════════ -->
    <style name="Theme.LearnLog" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ll_primary</item>
        <item name="colorOnPrimary">@color/ll_on_primary</item>
        <item name="colorPrimaryContainer">@color/ll_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/ll_on_primary_container</item>
        <item name="colorPrimaryInverse">@color/ll_inverse_primary</item>

        <item name="colorSecondary">@color/ll_secondary</item>
        <item name="colorOnSecondary">@color/ll_on_secondary</item>
        <item name="colorSecondaryContainer">@color/ll_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/ll_on_secondary_container</item>

        <item name="colorTertiary">@color/ll_tertiary</item>
        <item name="colorOnTertiary">@color/ll_on_tertiary</item>
        <item name="colorTertiaryContainer">@color/ll_tertiary_container</item>
        <item name="colorOnTertiaryContainer">@color/ll_on_tertiary_container</item>

        <item name="colorError">@color/ll_error</item>
        <item name="colorOnError">@color/ll_on_error</item>
        <item name="colorErrorContainer">@color/ll_error_container</item>
        <item name="colorOnErrorContainer">@color/ll_on_error_container</item>

        <item name="android:colorBackground">@color/ll_background</item>
        <item name="colorOnBackground">@color/ll_on_background</item>
        <item name="colorSurface">@color/ll_surface</item>
        <item name="colorOnSurface">@color/ll_on_surface</item>
        <item name="colorSurfaceVariant">@color/ll_surface_container</item>
        <item name="colorOnSurfaceVariant">@color/ll_on_surface_variant</item>
        <item name="colorSurfaceContainerLowest">@color/ll_surface_lowest</item>
        <item name="colorSurfaceContainerLow">@color/ll_surface_low</item>
        <item name="colorSurfaceContainer">@color/ll_surface_container</item>
        <item name="colorSurfaceContainerHigh">@color/ll_surface_high</item>
        <item name="colorSurfaceContainerHighest">@color/ll_surface_highest</item>
        <item name="colorSurfaceInverse">@color/ll_inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/ll_inverse_on_surface</item>
        <item name="colorOutline">@color/ll_outline</item>
        <item name="colorOutlineVariant">@color/ll_outline_variant</item>
        <item name="elevationOverlayEnabled">false</item>

        <!-- System bars blend into the page -->
        <item name="android:statusBarColor">@color/ll_background</item>
        <item name="android:navigationBarColor">@color/ll_background</item>
        <item name="android:windowLightStatusBar">@bool/ll_light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/ll_light_system_bars</item>
        <item name="android:windowBackground">@color/ll_background</item>

        <!-- Typography -->
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="textAppearanceDisplayLarge">@style/TextAppearance.LearnLog.DisplayLarge</item>
        <item name="textAppearanceDisplayMedium">@style/TextAppearance.LearnLog.DisplayMedium</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.LearnLog.DisplaySmall</item>
        <item name="textAppearanceHeadlineLarge">@style/TextAppearance.LearnLog.HeadlineLarge</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.LearnLog.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.LearnLog.HeadlineSmall</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.LearnLog.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.LearnLog.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.LearnLog.TitleSmall</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.LearnLog.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.LearnLog.BodyMedium</item>
        <item name="textAppearanceBodySmall">@style/TextAppearance.LearnLog.BodySmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.LearnLog.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.LearnLog.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.LearnLog.LabelSmall</item>

        <!-- Shapes -->
        <item name="shapeAppearanceCornerSmall">@style/ShapeAppearance.LearnLog.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/ShapeAppearance.LearnLog.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/ShapeAppearance.LearnLog.Large</item>
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LearnLog.ExtraLarge</item>

        <!-- Components -->
        <item name="materialCardViewStyle">@style/Widget.LearnLog.Card</item>
        <item name="materialButtonStyle">@style/Widget.LearnLog.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.LearnLog.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.LearnLog.Button.Text</item>
        <item name="chipStyle">@style/Widget.LearnLog.Chip.Filter</item>
        <item name="textInputStyle">@style/Widget.LearnLog.TextInput</item>
        <item name="bottomNavigationStyle">@style/Widget.LearnLog.BottomNav</item>
        <item name="floatingActionButtonStyle">@style/Widget.LearnLog.Fab</item>
        <item name="extendedFloatingActionButtonStyle">@style/Widget.LearnLog.ExtendedFab</item>
        <item name="materialSwitchStyle">@style/Widget.LearnLog.Switch</item>
        <item name="checkboxStyle">@style/Widget.LearnLog.CheckBox</item>
        <item name="circularProgressIndicatorStyle">@style/Widget.LearnLog.CircularProgress</item>
        <item name="linearProgressIndicatorStyle">@style/Widget.LearnLog.LinearProgress</item>
        <item name="bottomSheetDialogTheme">@style/ThemeOverlay.LearnLog.BottomSheetDialog</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.LearnLog.AlertDialog</item>
        <item name="snackbarStyle">@style/Widget.LearnLog.Snackbar</item>
        <item name="snackbarTextViewStyle">@style/Widget.LearnLog.Snackbar.Text</item>
        <item name="materialCalendarTheme">@style/ThemeOverlay.LearnLog.DatePicker</item>
        <item name="materialTimePickerTheme">@style/ThemeOverlay.LearnLog.TimePicker</item>
        <item name="navigationViewStyle">@style/Widget.LearnLog.NavigationView</item>
        <item name="popupMenuStyle">@style/Widget.LearnLog.PopupMenu</item>
    </style>

    <!-- Splash: shown while the app starts, then swaps to Theme.LearnLog -->
    <style name="Theme.LearnLog.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ll_primary_splash</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_mark</item>
        <item name="windowSplashScreenAnimationDuration">400</item>
        <item name="postSplashScreenTheme">@style/Theme.LearnLog</item>
    </style>

    <!-- ═════════════ Typography (Plus Jakarta Sans) ═════════════ -->
    <style name="TextAppearance.LearnLog.DisplayLarge" parent="TextAppearance.Material3.DisplayLarge">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">52sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.LearnLog.DisplayMedium" parent="TextAppearance.Material3.DisplayMedium">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">40sp</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>
    <style name="TextAppearance.LearnLog.DisplaySmall" parent="TextAppearance.Material3.DisplaySmall">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">32sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.LearnLog.HeadlineLarge" parent="TextAppearance.Material3.HeadlineLarge">
        <item name="android:fontFamily">@font/jakarta_extrabold</item>
        <item name="fontFamily">@font/jakarta_extrabold</item>
        <item name="android:textSize">30sp</item>
        <item name="android:letterSpacing">-0.015</item>
    </style>
    <style name="TextAppearance.LearnLog.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">26sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.LearnLog.HeadlineSmall" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">22sp</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>
    <style name="TextAppearance.LearnLog.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">19sp</item>
    </style>
    <style name="TextAppearance.LearnLog.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="fontFamily">@font/jakarta_regular</item>
        <item name="android:textSize">16sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.BodyMedium" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:fontFamily">@font/jakarta_regular</item>
        <item name="fontFamily">@font/jakarta_regular</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.BodySmall" parent="TextAppearance.Material3.BodySmall">
        <item name="android:fontFamily">@font/jakarta_medium</item>
        <item name="fontFamily">@font/jakarta_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
    </style>
    <style name="TextAppearance.LearnLog.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">@font/jakarta_semibold</item>
        <item name="fontFamily">@font/jakarta_semibold</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.01</item>
    </style>
    <style name="TextAppearance.LearnLog.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:fontFamily">@font/jakarta_bold</item>
        <item name="fontFamily">@font/jakarta_bold</item>
        <item name="android:textSize">11sp</item>
        <item name="android:letterSpacing">0.06</item>
    </style>
    <!-- Big tabular numbers for timer/stats -->
    <style name="TextAppearance.LearnLog.Numeric" parent="TextAppearance.LearnLog.DisplayLarge">
        <item name="android:fontFeatureSettings">tnum</item>
        <item name="android:letterSpacing">-0.03</item>
    </style>
    <style name="TextAppearance.LearnLog.Overline" parent="TextAppearance.LearnLog.LabelSmall">
        <item name="android:textAllCaps">true</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- ═════════════ Shapes ═════════════ -->
    <style name="ShapeAppearance.LearnLog.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="ShapeAppearance.LearnLog.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>
    <style name="ShapeAppearance.LearnLog.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">24dp</item>
    </style>
    <style name="ShapeAppearance.LearnLog.ExtraLarge" parent="ShapeAppearance.Material3.Corner.ExtraLarge">
        <item name="cornerSize">32dp</item>
    </style>
    <style name="ShapeAppearance.LearnLog.Pill" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.LearnLog.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">32dp</item>
        <item name="cornerSizeTopRight">32dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <!-- ═════════════ Overlays ═════════════ -->
    <style name="ThemeOverlay.LearnLog.BottomSheetDialog" parent="ThemeOverlay.Material3.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/Widget.LearnLog.BottomSheet</item>
        <item name="android:navigationBarColor">@color/ll_surface</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/ll_light_system_bars</item>
    </style>
    <style name="Widget.LearnLog.BottomSheet" parent="Widget.Material3.BottomSheet.Modal">
        <item name="backgroundTint">@color/ll_surface</item>
        <item name="shapeAppearance">@style/ShapeAppearance.LearnLog.BottomSheet</item>
    </style>

    <style name="ThemeOverlay.LearnLog.AlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LearnLog.Large</item>
        <item name="materialAlertDialogTitleTextStyle">@style/MaterialAlertDialog.LearnLog.Title</item>
        <item name="materialAlertDialogBodyTextStyle">@style/MaterialAlertDialog.LearnLog.Body</item>
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LearnLog.Button.Text.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.LearnLog.Button.Text.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.LearnLog.Button.Text.Dialog</item>
        <item name="backgroundTint">@color/ll_surface</item>
    </style>
    <style name="MaterialAlertDialog.LearnLog.Title" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textAppearance">@style/TextAppearance.LearnLog.TitleLarge</item>
    </style>
    <style name="MaterialAlertDialog.LearnLog.Body" parent="MaterialAlertDialog.Material3.Body.Text">
        <item name="android:textAppearance">@style/TextAppearance.LearnLog.BodyMedium</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="ThemeOverlay.LearnLog.AlertDialog.Destructive" parent="ThemeOverlay.LearnLog.AlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.LearnLog.Button.Text.Dialog.Destructive</item>
    </style>

    <style name="ThemeOverlay.LearnLog.DatePicker" parent="ThemeOverlay.Material3.MaterialCalendar">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LearnLog.Large</item>
    </style>
    <style name="ThemeOverlay.LearnLog.TimePicker" parent="ThemeOverlay.Material3.MaterialTimePicker">
        <item name="shapeAppearanceCornerExtraLarge">@style/ShapeAppearance.LearnLog.Large</item>
    </style>
</resources>
