<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="20dp">

    <com.google.android.material.bottomsheet.BottomSheetDragHandleView
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="8dp"
        android:text="@string/reschedule_title"
        android:textAppearance="?attr/textAppearanceTitleLarge" />

    <TextView
        android:id="@+id/btn_today"
        style="@style/LearnLog.SheetRow"
        android:text="@string/reschedule_today"
        app:drawableStartCompat="@drawable/ic_today" />

    <TextView
        android:id="@+id/btn_tomorrow"
        style="@style/LearnLog.SheetRow"
        android:text="@string/reschedule_tomorrow"
        app:drawableStartCompat="@drawable/ic_event" />

    <TextView
        android:id="@+id/btn_this_weekend"
        style="@style/LearnLog.SheetRow"
        android:text="@string/reschedule_weekend"
        app:drawableStartCompat="@drawable/ic_star" />

    <TextView
        android:id="@+id/btn_next_week"
        style="@style/LearnLog.SheetRow"
        android:text="@string/reschedule_next_week"
        app:drawableStartCompat="@drawable/ic_chevron_right" />

    <TextView
        android:id="@+id/btn_pick_date_time"
        style="@style/LearnLog.SheetRow"
        android:text="@string/reschedule_pick"
        app:drawableStartCompat="@drawable/ic_schedule" />
</LinearLayout>
