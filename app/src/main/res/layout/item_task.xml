<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/task_card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/page_gutter"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="@dimen/page_gutter"
    android:layout_marginBottom="5dp"
    android:checkable="false"
    android:clickable="true"
    android:focusable="true"
    app:shapeAppearance="@style/ShapeAppearance.LearnLog.Medium">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingTop="12dp"
        android:paddingEnd="10dp"
        android:paddingBottom="12dp">

        <!-- Priority accent -->
        <View
            android:id="@+id/priority_bar"
            android:layout_width="4dp"
            android:layout_height="38dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/bg_priority_bar"
            android:backgroundTint="@color/priority_medium" />

        <CheckBox
            android:id="@+id/check_complete"
            style="@style/Widget.LearnLog.CheckCircle"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                android:textColor="?attr/colorOnSurface"
                tools:text="Finish calculus problem set 4" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/meta_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                app:chipSpacingHorizontal="6dp"
                app:chipSpacingVertical="4dp">

                <TextView
                    android:id="@+id/text_due"
                    style="@style/Widget.LearnLog.Pill"
                    app:drawableStartCompat="@drawable/ic_schedule"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="Today · 5:00 PM" />

                <TextView
                    android:id="@+id/text_subject"
                    style="@style/Widget.LearnLog.Pill"
                    android:maxWidth="160dp"
                    app:drawableStartCompat="@drawable/ic_subject"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="Mathematics" />

                <TextView
                    android:id="@+id/text_duration"
                    style="@style/Widget.LearnLog.Pill"
                    app:drawableStartCompat="@drawable/ic_hourglass"
                    app:drawableTint="?attr/colorOnSurfaceVariant"
                    tools:text="45 min" />

                <TextView
                    android:id="@+id/text_status"
                    style="@style/Widget.LearnLog.Pill"
                    android:backgroundTint="?attr/colorSecondaryContainer"
                    android:text="@string/status_in_progress"
                    android:textColor="?attr/colorOnSecondaryContainer"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_start_timer"
            style="@style/Widget.LearnLog.IconButton.Tonal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/action_start_focus"
            app:backgroundTint="?attr/colorPrimaryContainer"
            app:icon="@drawable/ic_play"
            app:iconTint="?attr/colorOnPrimaryContainer" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
