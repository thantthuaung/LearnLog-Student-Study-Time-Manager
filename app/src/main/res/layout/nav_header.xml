<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="16dp"
    android:paddingTop="16dp"
    android:paddingEnd="16dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_hero_gradient"
        android:orientation="vertical"
        android:padding="20dp">

        <FrameLayout
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:background="@drawable/bg_dot"
            android:backgroundTint="@color/white_20">

            <TextView
                android:id="@+id/drawer_initials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                android:textColor="@color/white"
                tools:text="TA" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/drawer_avatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:visibility="gone"
                app:shapeAppearance="@style/ShapeAppearance.LearnLog.Pill"
                app:strokeColor="@color/white_80"
                app:strokeWidth="2dp" />
        </FrameLayout>

        <TextView
            android:id="@+id/drawer_display_name"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceTitleLarge"
            android:textColor="@color/white"
            tools:text="Thant Thu Aung" />

        <TextView
            android:id="@+id/drawer_email"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:maxLines="1"
            android:ellipsize="end"
            android:textAppearance="?attr/textAppearanceBodySmall"
            android:textColor="@color/white_80"
            tools:text="student@example.com" />

        <TextView
            android:id="@+id/drawer_streak"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_pill"
            android:backgroundTint="@color/white_20"
            android:drawablePadding="6dp"
            android:paddingStart="10dp"
            android:paddingTop="5dp"
            android:paddingEnd="12dp"
            android:paddingBottom="5dp"
            android:text="@string/app_tagline"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/white"
            app:drawableStartCompat="@drawable/ic_school"
            app:drawableTint="@color/white" />
    </LinearLayout>
</LinearLayout>
