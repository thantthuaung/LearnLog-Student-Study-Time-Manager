<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:paddingBottom="@dimen/bottom_nav_clearance">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <include
            android:id="@+id/top_bar"
            layout="@layout/top_bar" />

        <!-- Linked task -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/task_card"
            style="@style/Widget.LearnLog.Card.Tonal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="@dimen/page_gutter"
            app:shapeAppearance="@style/ShapeAppearance.LearnLog.Medium">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="64dp"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="8dp"
                android:paddingBottom="10dp">

                <FrameLayout
                    android:layout_width="@dimen/icon_tile"
                    android:layout_height="@dimen/icon_tile"
                    android:background="@drawable/bg_icon_tile"
                    android:backgroundTint="?attr/colorPrimaryContainer">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_target"
                        app:tint="?attr/colorOnPrimaryContainer" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/task_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/timer_linked_task"
                        android:textAppearance="?attr/textAppearanceLabelMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/task_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="?attr/textAppearanceTitleMedium"
                        tools:text="Calculus problem set" />
                </LinearLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/task_action"
                    style="@style/Widget.LearnLog.Button.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Remove" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Ring -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp">

            <View
                android:id="@+id/ring_glow"
                android:layout_width="@dimen/timer_ring"
                android:layout_height="@dimen/timer_ring"
                android:layout_gravity="center"
                android:alpha="0"
                android:background="@drawable/bg_dot"
                android:backgroundTint="?attr/colorPrimaryContainer" />

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress_ring"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:max="1000"
                app:indicatorColor="?attr/colorPrimary"
                app:indicatorSize="@dimen/timer_ring"
                app:trackColor="?attr/colorSurfaceContainerHigh"
                app:trackCornerRadius="10dp"
                app:trackThickness="14dp"
                tools:progress="350" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/state_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_pill"
                    android:paddingStart="12dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="4dp"
                    android:textAppearance="?attr/textAppearanceLabelMedium"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="Ready to focus" />

                <TextView
                    android:id="@+id/text_countdown"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:includeFontPadding="false"
                    android:textAppearance="@style/TextAppearance.LearnLog.Numeric"
                    android:textColor="?attr/colorOnSurface"
                    tools:text="25:00" />

                <TextView
                    android:id="@+id/text_focused"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    tools:text="of 25 min" />
            </LinearLayout>
        </FrameLayout>

        <!-- Adjust -->
        <LinearLayout
            android:id="@+id/adjust_row"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_decrease"
                style="@style/Widget.LearnLog.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="40dp"
                android:contentDescription="@string/timer_minus_one"
                android:text="−1"
                app:icon="@drawable/ic_remove"
                tools:ignore="HardcodedText" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_increase"
                style="@style/Widget.LearnLog.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:minHeight="40dp"
                android:contentDescription="@string/timer_plus_five"
                android:text="+5"
                app:icon="@drawable/ic_add"
                tools:ignore="HardcodedText" />
        </LinearLayout>

        <!-- Controls -->
        <LinearLayout
            android:id="@+id/controls"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_reset"
                style="@style/Widget.LearnLog.IconButton.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/timer_reset"
                app:icon="@drawable/ic_restart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_pause"
                android:layout_width="wrap_content"
                android:layout_height="64dp"
                android:layout_marginStart="18dp"
                android:layout_marginEnd="18dp"
                android:minWidth="152dp"
                android:textSize="17sp"
                app:icon="@drawable/ic_play"
                app:iconSize="26dp"
                app:shapeAppearance="@style/ShapeAppearance.LearnLog.Pill"
                tools:text="Start" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_finish"
                style="@style/Widget.LearnLog.IconButton.Tonal"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:contentDescription="@string/finish"
                app:icon="@drawable/ic_check" />
        </LinearLayout>

        <!-- Completion -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/complete_card"
            style="@style/Widget.LearnLog.Card.Static"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="@dimen/page_gutter"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorTertiaryContainer"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="20dp">

                <ImageView
                    android:id="@+id/complete_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_trophy"
                    app:tint="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/timer_complete_title"
                    android:textAppearance="?attr/textAppearanceTitleLarge"
                    android:textColor="?attr/colorOnTertiaryContainer" />

                <TextView
                    android:id="@+id/complete_message"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?attr/colorOnTertiaryContainer"
                    tools:text="25 min of focus added to your log." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/complete_secondary"
                        style="@style/Widget.LearnLog.Button.Outlined"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        app:strokeColor="?attr/colorOnTertiaryContainer"
                        tools:text="Still working" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/complete_primary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        app:backgroundTint="?attr/colorTertiary"
                        tools:text="Mark done" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Presets -->
        <TextView
            android:id="@+id/presets_label"
            style="@style/LearnLog.SectionLabel"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="26dp"
            android:text="@string/timer_presets" />

        <HorizontalScrollView
            android:id="@+id/presets_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:clipToPadding="false"
            android:paddingStart="@dimen/page_gutter"
            android:paddingEnd="@dimen/page_gutter"
            android:scrollbars="none">

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/preset_chips"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:singleLine="true"
                app:singleSelection="true" />
        </HorizontalScrollView>

        <!-- Daily goal -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/goal_card"
            style="@style/Widget.LearnLog.Card.Static"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="22dp"
            android:layout_marginEnd="@dimen/page_gutter">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="18dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/ic_fire"
                        app:tint="?attr/colorSecondary" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/timer_daily_goal"
                        android:textAppearance="?attr/textAppearanceTitleSmall" />

                    <TextView
                        android:id="@+id/goal_text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textAppearance="?attr/textAppearanceLabelLarge"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        tools:text="45m of 2h" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/goal_progress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:max="1000"
                    app:indicatorColor="?attr/colorSecondary"
                    app:trackThickness="8dp"
                    tools:progress="380" />

                <TextView
                    android:id="@+id/goal_reached"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/timer_goal_reached"
                    android:textAppearance="?attr/textAppearanceBodySmall"
                    android:textColor="?attr/colorSecondary"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/switch_keep_screen_on"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/page_gutter"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="@dimen/page_gutter"
            android:minHeight="56dp"
            android:paddingStart="4dp"
            android:text="@string/timer_keep_screen_on"
            android:textAppearance="?attr/textAppearanceBodyLarge" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
