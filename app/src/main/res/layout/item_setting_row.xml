<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/row"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="64dp"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingTop="10dp"
    android:paddingEnd="16dp"
    android:paddingBottom="10dp">

    <FrameLayout
        android:id="@+id/row_icon_tile"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/bg_icon_tile"
        android:backgroundTint="?attr/colorSurfaceContainerHigh">

        <ImageView
            android:id="@+id/row_icon"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:layout_gravity="center"
            android:importantForAccessibility="no"
            app:tint="?attr/colorOnSurface"
            tools:src="@drawable/ic_tune" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/row_title"
            style="@style/LearnLog.RowTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="Theme" />

        <TextView
            android:id="@+id/row_subtitle"
            style="@style/LearnLog.RowSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:visibility="gone"
            tools:text="Follow the system setting"
            tools:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/row_value"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:maxWidth="160dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:visibility="gone"
        tools:text="System"
        tools:visibility="visible" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/row_switch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/row_chevron"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="4dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="?attr/colorOutline" />
</LinearLayout>
